<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Parceiros - Ar.Soluções Integradas</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Ícones Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <!-- CSS externo -->
  <link rel="stylesheet" href="CSS/style.css">
</head>
<body>

  <div class="container my-5">
    <h2 class="text-center mb-4">Produtos de Nossos Parceiros</h2>
    
    <div class="row g-4">
      <!-- Card Produto 1 -->
      <div class="col-md-4">
        <div class="card product-card h-100 shadow-sm">
          <img src="img/produto1.jpg" class="card-img-top product-img" alt="Produto 1">
          <div class="card-body">
            <h5 class="card-title">Produto Parceiro A</h5>
            <p class="card-text">Descrição resumida do produto, destacando características principais.</p>
            <p class="price">R$ 199,90 <span class="promo">R$ 179,90</span></p>
            <div class="payment-methods mt-2">
              <span><i class="bi bi-credit-card"></i> Cartão</span>
              <span><i class="bi bi-cash"></i> Boleto</span>
              <span><i class="bi bi-qr-code"></i> Pix</span>
            </div>
          </div>
          <div class="card-footer text-center bg-white">
            <img src="img/logo-parceiro1.png" class="partner-logo" alt="Parceiro A">
          </div>
        </div>
      </div>

      <!-- Card Produto 2 -->
      <div class="col-md-4">
        <div class="card product-card h-100 shadow-sm">
          <img src="img/produto2.jpg" class="card-img-top product-img" alt="Produto 2">
          <div class="card-body">
            <h5 class="card-title">Produto Parceiro B</h5>
            <p class="card-text">Descrição resumida do produto, destacando características principais.</p>
            <p class="price">R$ 89,90</p>
            <div class="payment-methods mt-2">
              <span><i class="bi bi-credit-card"></i> Cartão</span>
              <span><i class="bi bi-qr-code"></i> Pix</span>
            </div>
          </div>
          <div class="card-footer text-center bg-white">
            <img src="img/logo-parceiro2.png" class="partner-logo" alt="Parceiro B">
          </div>
        </div>
      </div>

      <!-- Card Produto 3 -->
      <div class="col-md-4">
        <div class="card product-card h-100 shadow-sm">
          <img src="img/produto3.jpg" class="card-img-top product-img" alt="Produto 3">
          <div class="card-body">
            <h5 class="card-title">Produto Parceiro C</h5>
            <p class="card-text">Descrição resumida do produto, destacando características principais.</p>
            <p class="price">R$ 149,90</p>
            <div class="payment-methods mt-2">
              <span><i class="bi bi-credit-card"></i> Cartão</span>
              <span><i class="bi bi-cash"></i> Boleto</span>
            </div>
          </div>
          <div class="card-footer text-center bg-white">
            <img src="img/logo-parceiro3.png" class="partner-logo" alt="Parceiro C">
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
